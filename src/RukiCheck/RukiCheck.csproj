<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- ポータブルEXE設定 -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- アプリケーション情報 -->
    <AssemblyName>RukiCheck</AssemblyName>
    <RootNamespace>RukiCheck</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Copyright>2025 RukiCheck Project</Copyright>
    <Description>Windows ポータブル検品ツール</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF 基本パッケージは SDK に含まれる -->

    <!-- 依存性注入 -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />

    <!-- 音声処理 -->
    <PackageReference Include="NAudio" Version="2.2.1" />

    <!-- カメラキャプチャ -->
    <PackageReference Include="OpenCvSharp4" Version="4.9.0.20240103" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.9.0.20240103" />

    <!-- JSON シリアライズ（.NETに標準搭載だが明示） -->
    <!-- System.Text.Json は .NET に含まれるため不要 -->
  </ItemGroup>

</Project>
