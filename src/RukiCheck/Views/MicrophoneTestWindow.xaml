<Window x:Class="RukiCheck.Views.MicrophoneTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="🎤 マイク検査" Height="550" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F5F7FA" Offset="0"/>
                <GradientStop Color="#E3F2FD" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0" Background="#2196F3" Padding="20" Margin="20,20,20,10" CornerRadius="10">
            <StackPanel>
                <TextBlock Text="🎤 マイク検査" FontSize="28" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="5秒間録音して、再生で確認します" FontSize="14"
                           Foreground="White" Opacity="0.9" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- メインコンテンツ -->
        <StackPanel Grid.Row="1" Margin="40,20">
            <!-- 1. 録音セクション -->
            <Border Background="White" CornerRadius="10" Padding="25" Margin="0,10"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="1️⃣ 録音" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <Button Content="🔴 録音開始（5秒）" Command="{Binding StartRecordingCommand}"
                            Height="50" FontSize="16" FontWeight="Bold"
                            Background="#F44336" Foreground="White" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="8" Padding="15">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E53935"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#BDBDBD"/>
                                        <Setter Property="Foreground" Value="#757575"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- プログレスバー -->
                    <ProgressBar Height="20" Value="{Binding RecordingProgress}" Maximum="100"
                                 Margin="0,15,0,0" Foreground="#F44336" Background="#EEEEEE"/>

                    <TextBlock Text="{Binding RecordingProgress, StringFormat={}{0}%}"
                               HorizontalAlignment="Center" FontSize="12" Foreground="#666" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- 2. 再生セクション -->
            <Border Background="White" CornerRadius="10" Padding="25" Margin="0,10"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="2️⃣ 再生確認" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <Button Content="▶ 再生する" Command="{Binding PlayRecordingCommand}"
                            Height="50" FontSize="16" FontWeight="Bold"
                            Background="#2196F3" Foreground="White" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="8" Padding="15">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1976D2"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#BDBDBD"/>
                                        <Setter Property="Foreground" Value="#757575"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 3. 確認セクション -->
            <Border Background="White" CornerRadius="10" Padding="25" Margin="0,10"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="3️⃣ 音が聞こえましたか？" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="✅ はい（聞こえた）" Command="{Binding ConfirmYesCommand}"
                                Width="200" Height="50" FontSize="14" FontWeight="Bold"
                                Background="#4CAF50" Foreground="White" BorderThickness="0" Margin="5">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="8" Padding="15">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#66BB6A"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#BDBDBD"/>
                                            <Setter Property="Foreground" Value="#757575"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="❌ いいえ（聞こえない）" Command="{Binding ConfirmNoCommand}"
                                Width="200" Height="50" FontSize="14" FontWeight="Bold"
                                Background="#FF5722" Foreground="White" BorderThickness="0" Margin="5">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="8" Padding="15">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F4511E"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#BDBDBD"/>
                                            <Setter Property="Foreground" Value="#757575"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ステータス -->
        <Border Grid.Row="2" Background="White" Padding="15" Margin="20,10" CornerRadius="10"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <TextBlock Text="{Binding StatusMessage}" FontSize="14" FontWeight="Bold"
                       Foreground="#2196F3" HorizontalAlignment="Center"/>
        </Border>

        <!-- ボタン -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="20">
            <Button Content="🔄 リセット" Command="{Binding ResetCommand}"
                    Width="150" Height="45" FontSize="16" FontWeight="Bold"
                    Background="#9E9E9E" Foreground="White" BorderThickness="0" Margin="5">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8" Padding="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#BDBDBD"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
