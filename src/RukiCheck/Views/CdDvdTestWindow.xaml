<Window x:Class="RukiCheck.Views.CdDvdTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="💿 CD/DVDドライブ検査" Height="600" Width="650"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F5F7FA" Offset="0"/>
                <GradientStop Color="#FFF3E0" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0" Background="#FF9800" Padding="20" Margin="20,20,20,10" CornerRadius="10">
            <StackPanel>
                <TextBlock Text="💿 CD/DVDドライブ検査" FontSize="28" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="光学ドライブの検出とメディア読み込みを確認します" FontSize="14"
                           Foreground="White" Opacity="0.9" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- メインコンテンツ -->
        <StackPanel Grid.Row="1" Margin="40,20">
            <!-- 1. ドライブスキャン -->
            <Border Background="White" CornerRadius="10" Padding="25" Margin="0,10"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="1️⃣ ドライブスキャン" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <Button Content="🔍 ドライブをスキャン" Command="{Binding ScanDriveCommand}"
                            Height="50" FontSize="16" FontWeight="Bold"
                            Background="#FF9800" Foreground="White" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="8" Padding="15">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FB8C00"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#BDBDBD"/>
                                        <Setter Property="Foreground" Value="#757575"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- ドライブ情報表示 -->
                    <Border Background="#FFF8E1" CornerRadius="5" Padding="15" Margin="0,15,0,0"
                            Visibility="{Binding DriveFound, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock FontSize="14" Margin="0,2">
                                <Run Text="ドライブ名: " FontWeight="Bold"/>
                                <Run Text="{Binding DriveName}"/>
                            </TextBlock>
                            <TextBlock FontSize="14" Margin="0,2">
                                <Run Text="ドライブレター: " FontWeight="Bold"/>
                                <Run Text="{Binding DriveLetter}"/>
                            </TextBlock>
                            <TextBlock FontSize="14" Margin="0,2">
                                <Run Text="メディア: " FontWeight="Bold"/>
                                <Run Text="{Binding MediaInserted, Converter={StaticResource BoolToTextConverter}, ConverterParameter='挿入済み|未挿入'}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 2. 読み込みテスト -->
            <Border Background="White" CornerRadius="10" Padding="25" Margin="0,10"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="2️⃣ 読み込みテスト" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <TextBlock Text="※ CD/DVDメディアを挿入してからテストしてください"
                               FontSize="12" Foreground="#666" Margin="0,0,0,10"/>

                    <Button Content="📀 読み込みテスト実行" Command="{Binding ReadTestCommand}"
                            Height="50" FontSize="16" FontWeight="Bold"
                            Background="#2196F3" Foreground="White" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="8" Padding="15">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1976D2"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#BDBDBD"/>
                                        <Setter Property="Foreground" Value="#757575"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- テスト結果表示 -->
                    <Border Background="#E3F2FD" CornerRadius="5" Padding="15" Margin="0,15,0,0"
                            Visibility="{Binding ReadTestSuccess, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock FontSize="14" Margin="0,2">
                                <Run Text="✅ 読み込み成功！" FontWeight="Bold" Foreground="#4CAF50"/>
                            </TextBlock>
                            <TextBlock FontSize="14" Margin="0,2">
                                <Run Text="検出: " FontWeight="Bold"/>
                                <Run Text="{Binding FilesRead}"/>
                                <Run Text=" 個のファイル/フォルダ"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 3. 確認セクション -->
            <Border Background="White" CornerRadius="10" Padding="25" Margin="0,10"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="3️⃣ CD/DVDドライブは正常に動作しましたか？" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="✅ はい（正常）" Command="{Binding ConfirmYesCommand}"
                                Width="200" Height="50" FontSize="14" FontWeight="Bold"
                                Background="#4CAF50" Foreground="White" BorderThickness="0" Margin="5">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="8" Padding="15">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#66BB6A"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#BDBDBD"/>
                                            <Setter Property="Foreground" Value="#757575"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="❌ いいえ（異常）" Command="{Binding ConfirmNoCommand}"
                                Width="200" Height="50" FontSize="14" FontWeight="Bold"
                                Background="#FF5722" Foreground="White" BorderThickness="0" Margin="5">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="8" Padding="15">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F4511E"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#BDBDBD"/>
                                            <Setter Property="Foreground" Value="#757575"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ステータス -->
        <Border Grid.Row="2" Background="White" Padding="15" Margin="20,10" CornerRadius="10"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <TextBlock Text="{Binding StatusMessage}" FontSize="14" FontWeight="Bold"
                       Foreground="#FF9800" HorizontalAlignment="Center"/>
        </Border>

        <!-- ボタン -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="20">
            <Button Content="✔ 完了" Click="CompleteButton_Click"
                    Width="150" Height="45" FontSize="16" FontWeight="Bold"
                    Background="#4CAF50" Foreground="White" BorderThickness="0" Margin="5"
                    IsEnabled="{Binding UserConfirmed, Converter={StaticResource NotNullToBoolConverter}}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8" Padding="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#66BB6A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#BDBDBD"/>
                                <Setter Property="Foreground" Value="#757575"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="キャンセル" Click="CancelButton_Click"
                    Width="150" Height="45" FontSize="16" FontWeight="Bold"
                    Background="#9E9E9E" Foreground="White" BorderThickness="0" Margin="5">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8" Padding="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#BDBDBD"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
