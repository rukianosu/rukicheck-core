<Window x:Class="RukiCheck.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RukiCheck - ポータブル検品ツール v0.1"
        Height="700" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0" Background="#667eea" Padding="20" CornerRadius="10" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="🔍 RukiCheck ポータブル検品ツール"
                           FontSize="28" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="v0.1.0 - インストール不要 | 標準ユーザー権限で動作"
                           FontSize="12" Foreground="White" Opacity="0.9"
                           HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- 初期設定 -->
        <GroupBox Grid.Row="1" Header="📋 初期設定" Padding="15" Margin="0,0,0,20">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 管理番号 -->
                    <Label Grid.Row="0" Grid.Column="0" Content="管理番号:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ManagementId, UpdateSourceTrigger=PropertyChanged}"
                             Width="300" HorizontalAlignment="Left"
                             ToolTip="例: RT-250903"/>

                    <!-- 検品日 -->
                    <Label Grid.Row="1" Grid.Column="0" Content="検品日:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding InspectionDate, Mode=OneWay}"
                             IsReadOnly="True" Background="#f0f0f0"
                             Width="300" HorizontalAlignment="Left"/>

                    <!-- 保存先 -->
                    <Label Grid.Row="2" Grid.Column="0" Content="保存先:" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Text="{Binding SavePath}" Width="400" IsReadOnly="True" Background="#f0f0f0"/>
                        <Button Content="📁 選択" Command="{Binding SelectSavePathCommand}" Width="100"/>
                    </StackPanel>
                </Grid>

                <Button Content="🚀 検品開始" Command="{Binding StartInspectionCommand}"
                        Width="200" Height="40" FontSize="16" FontWeight="Bold"
                        Background="#4CAF50" Foreground="White" Margin="0,15,0,0"
                        HorizontalAlignment="Center"/>

                <Button Content="🔄 自動検査開始" Command="{Binding AutoInspectCommand}"
                        Width="200" Height="40" FontSize="16" FontWeight="Bold"
                        Background="#FF9800" Foreground="White" Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        ToolTip="全ての検査を順番に自動実行します">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Opacity" Value="1"/>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </GroupBox>

        <!-- 検査メニュー -->
        <GroupBox Grid.Row="2" Header="🧪 検査メニュー" Padding="15" IsEnabled="{Binding IsInspectionStarted}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- ストレージ -->
                    <Border BorderBrush="#ddd" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,5">
                        <StackPanel>
                            <TextBlock Text="💾 ストレージ空き容量チェック" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="Cドライブの空き容量を確認します（自動判定）"
                                       Foreground="Gray" Margin="0,5"/>
                            <Button Content="実行" Command="{Binding RunStorageTestCommand}" Width="120"/>
                        </StackPanel>
                    </Border>

                    <!-- キーボード -->
                    <Border BorderBrush="#ddd" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,5">
                        <StackPanel>
                            <TextBlock Text="⌨️ キーボード検査" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="全キーの入力を視覚的に確認します（JIS 109キー）"
                                       Foreground="Gray" Margin="0,5"/>
                            <Button Content="実行" Command="{Binding RunKeyboardTestCommand}" Width="120"/>
                        </StackPanel>
                    </Border>

                    <!-- マイク -->
                    <Border BorderBrush="#ddd" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,5">
                        <StackPanel>
                            <TextBlock Text="🎤 マイク検査" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="5秒間録音して再生確認します"
                                       Foreground="Gray" Margin="0,5"/>
                            <Button Content="実行" Command="{Binding RunMicrophoneTestCommand}" Width="120"/>
                        </StackPanel>
                    </Border>

                    <!-- スピーカー -->
                    <Border BorderBrush="#ddd" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,5">
                        <StackPanel>
                            <TextBlock Text="🔊 スピーカー検査" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="左右チャンネルの音を確認します"
                                       Foreground="Gray" Margin="0,5"/>
                            <Button Content="実行" Command="{Binding RunSpeakerTestCommand}" Width="120"/>
                        </StackPanel>
                    </Border>

                    <!-- カメラ -->
                    <Border BorderBrush="#ddd" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,5">
                        <StackPanel>
                            <TextBlock Text="📷 カメラ検査" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="プレビュー表示と静止画撮影"
                                       Foreground="Gray" Margin="0,5"/>
                            <Button Content="実行" Command="{Binding RunCameraTestCommand}" Width="120"/>
                        </StackPanel>
                    </Border>

                    <!-- トラックパッド -->
                    <Border BorderBrush="#ddd" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,5">
                        <StackPanel>
                            <TextBlock Text="🖱️ トラックパッド検査" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="カーソル移動・クリック・スクロールを確認します"
                                       Foreground="Gray" Margin="0,5"/>
                            <Button Content="実行" Command="{Binding RunTrackpadTestCommand}" Width="120"/>
                        </StackPanel>
                    </Border>

                    <!-- CPU -->
                    <Border BorderBrush="#ddd" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,5">
                        <StackPanel>
                            <TextBlock Text="🖥️ CPU簡易負荷テスト" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="60秒間の計算負荷でフリーズ・異常停止を確認"
                                       Foreground="Gray" Margin="0,5"/>
                            <Button Content="実行（60秒）" Command="{Binding RunCpuTestCommand}" Width="120"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>

        <!-- 保存・完了 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,10">
            <Button Content="💾 レポート保存" Command="{Binding SaveReportCommand}"
                    Width="150" Height="40" FontSize="14" Background="#2196F3" Foreground="White"
                    IsEnabled="{Binding IsInspectionStarted}"/>
            <Button Content="📂 フォルダを開く" Command="{Binding OpenReportFolderCommand}"
                    Width="150" Height="40" FontSize="14"
                    IsEnabled="{Binding IsInspectionStarted}"/>
        </StackPanel>

        <!-- ステータスバー -->
        <Border Grid.Row="4" Background="#f5f5f5" Padding="10" BorderBrush="#ddd" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#555"/>
        </Border>
    </Grid>
</Window>
