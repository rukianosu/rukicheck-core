<Window x:Class="RukiCheck.Views.TouchScreenTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="👆 タッチスクリーン検査" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Grid>
        <!-- グラデーション背景 -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E3F2FD" Offset="0"/>
                <GradientStop Color="#BBDEFB" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0" Background="#2196F3" Padding="20" Margin="20,20,20,10" CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="3" BlurRadius="10" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="👆 タッチスクリーン検査" FontSize="28" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="画面をタップ・スワイプしてタッチ機能を確認します" FontSize="14"
                           Foreground="White" Opacity="0.9" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- メインコンテンツ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20">
            <StackPanel>
                <!-- タッチスクリーン検出情報 -->
                <Border Background="White" CornerRadius="10" Padding="20" Margin="0,10"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.2"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="📱 タッチスクリーン情報" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                        <TextBlock FontSize="13" Margin="0,3">
                            <Run Text="タッチスクリーン: " FontWeight="Bold"/>
                            <Run Text="{Binding TouchAvailable, Converter={StaticResource BoolToTextConverter}, ConverterParameter=検出されました|検出されませんでした}"
                                 Foreground="{Binding TouchAvailable, Converter={StaticResource BoolToColorConverter}, ConverterParameter=#4CAF50|#F44336}"/>
                        </TextBlock>

                        <TextBlock FontSize="13" Margin="0,3"
                                   Visibility="{Binding TouchAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Run Text="デバイス名: " FontWeight="Bold"/>
                            <Run Text="{Binding DeviceName, TargetNullValue=不明}"/>
                        </TextBlock>

                        <TextBlock FontSize="13" Margin="0,3"
                                   Visibility="{Binding TouchAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Run Text="最大タッチポイント: " FontWeight="Bold"/>
                            <Run Text="{Binding MaxTouchPoints}"/>
                            <Run Text="点"/>
                        </TextBlock>

                        <TextBlock FontSize="13" Margin="0,3"
                                   Visibility="{Binding TouchAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Run Text="マルチタッチ: " FontWeight="Bold"/>
                            <Run Text="{Binding MultiTouchSupported, Converter={StaticResource BoolToTextConverter}, ConverterParameter=対応|非対応}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- タッチテストエリア -->
                <Border Background="White" CornerRadius="10" Padding="20" Margin="0,10"
                        BorderBrush="#2196F3" BorderThickness="2"
                        Visibility="{Binding TouchAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.2"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="🖐️ タッチテスト" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                        <!-- タッチテストキャンバス -->
                        <Border x:Name="TouchTestCanvas"
                                Background="#E3F2FD" CornerRadius="10"
                                Height="300" Margin="0,10"
                                BorderBrush="#2196F3" BorderThickness="2"
                                TouchDown="TouchTestCanvas_TouchDown"
                                TouchUp="TouchTestCanvas_TouchUp"
                                TouchMove="TouchTestCanvas_TouchMove">
                            <Grid>
                                <TextBlock Text="👆 この領域をタップ・スワイプしてください"
                                           FontSize="18" FontWeight="Bold" Foreground="#2196F3"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Opacity="0.5"/>
                            </Grid>
                        </Border>

                        <!-- テスト結果 -->
                        <Grid Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- タップ検出 -->
                            <Border Grid.Column="0" Background="{Binding TapDetected, Converter={StaticResource BoolToColorConverter}, ConverterParameter=#E8F5E9|#FFF3E0}"
                                    CornerRadius="8" Padding="15" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="タップ" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <Viewbox Height="40" Margin="0,10">
                                        <TextBlock Text="{Binding TapDetected, Converter={StaticResource BoolToTextConverter}, ConverterParameter=✅|⏳}"
                                                   Foreground="{Binding TapDetected, Converter={StaticResource BoolToColorConverter}, ConverterParameter=#4CAF50|#BDBDBD}"/>
                                    </Viewbox>
                                </StackPanel>
                            </Border>

                            <!-- スワイプ検出 -->
                            <Border Grid.Column="1" Background="{Binding SwipeDetected, Converter={StaticResource BoolToColorConverter}, ConverterParameter=#E8F5E9|#FFF3E0}"
                                    CornerRadius="8" Padding="15" Margin="5">
                                <StackPanel>
                                    <TextBlock Text="スワイプ" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <Viewbox Height="40" Margin="0,10">
                                        <TextBlock Text="{Binding SwipeDetected, Converter={StaticResource BoolToTextConverter}, ConverterParameter=✅|⏳}"
                                                   Foreground="{Binding SwipeDetected, Converter={StaticResource BoolToColorConverter}, ConverterParameter=#4CAF50|#BDBDBD}"/>
                                    </Viewbox>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- タッチスクリーン非搭載メッセージ -->
                <Border Background="White" CornerRadius="10" Padding="30" Margin="0,10"
                        BorderBrush="#9E9E9E" BorderThickness="2"
                        Visibility="{Binding TouchAvailable, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.2"/>
                    </Border.Effect>
                    <StackPanel>
                        <Viewbox Height="80" Margin="0,0,0,20">
                            <TextBlock Text="ℹ️" Foreground="#9E9E9E"/>
                        </Viewbox>
                        <TextBlock Text="タッチスクリーンが検出されませんでした" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center" Foreground="#666" Margin="0,0,0,10"/>
                        <TextBlock Text="このPCにはタッチパネル機能が搭載されていません。" FontSize="14"
                                   HorizontalAlignment="Center" Foreground="#999"/>
                        <TextBlock Text="「完了」ボタンを押して次に進んでください。" FontSize="14"
                                   HorizontalAlignment="Center" Foreground="#999" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ステータスメッセージ -->
        <Border Grid.Row="2" Background="White" Padding="15" Margin="20,10" CornerRadius="10"
                BorderBrush="#2196F3" BorderThickness="2">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.2"/>
            </Border.Effect>
            <TextBlock Text="{Binding StatusMessage}" FontSize="16" FontWeight="Bold"
                       Foreground="#2196F3" HorizontalAlignment="Center"/>
        </Border>

        <!-- ボタン -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="20">
            <Button Content="🔄 リセット" Command="{Binding ResetCommand}"
                    Width="150" Height="45" FontSize="16" FontWeight="Bold"
                    Background="#9E9E9E" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Margin="5">
                <Button.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.4"/>
                </Button.Effect>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8" Padding="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#BDBDBD"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="✔ 完了" Command="{Binding CompleteCommand}"
                    Width="150" Height="45" FontSize="16" FontWeight="Bold"
                    Background="#4CAF50" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Margin="5">
                <Button.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.4"/>
                </Button.Effect>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8" Padding="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#66BB6A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#BDBDBD"/>
                                <Setter Property="Foreground" Value="#757575"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
