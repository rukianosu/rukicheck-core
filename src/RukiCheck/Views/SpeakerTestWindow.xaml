<Window x:Class="RukiCheck.Views.SpeakerTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="🔊 スピーカー検査" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Grid>
        <!-- グラデーション背景 -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFF3E0" Offset="0"/>
                <GradientStop Color="#FFE0B2" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0" Background="#FF9800" Padding="20" Margin="20,20,20,10" CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="3" BlurRadius="10" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="🔊 スピーカー検査" FontSize="28" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="左右のスピーカーから順番にテスト音を再生します" FontSize="14"
                           Foreground="White" Opacity="0.9" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- メインコンテンツ -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左スピーカーテスト -->
            <Border Grid.Column="0" Background="White" CornerRadius="15" Padding="30"
                    BorderBrush="#FF9800" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="5" BlurRadius="15" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="🔊 左スピーカー" FontSize="24" FontWeight="Bold"
                               Foreground="#FF9800" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <!-- ステータスアイコン -->
                    <Viewbox Height="120" Margin="0,20">
                        <TextBlock FontSize="80">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="⏳"/>
                                    <Setter Property="Foreground" Value="#BDBDBD"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding LeftTested}" Value="True"/>
                                                <Condition Binding="{Binding LeftConfirmed}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="✅"/>
                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding LeftTested}" Value="True"/>
                                                <Condition Binding="{Binding LeftConfirmed}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="❌"/>
                                            <Setter Property="Foreground" Value="#F44336"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Viewbox>

                    <!-- 再生ボタン -->
                    <Button Content="▶ テスト音を再生" Command="{Binding PlayLeftCommand}"
                            Height="50" FontSize="16" FontWeight="Bold"
                            Background="#FF9800" Foreground="White" BorderThickness="0"
                            Cursor="Hand" Margin="0,20,0,10">
                        <Button.Effect>
                            <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.4"/>
                        </Button.Effect>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="8" Padding="15">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FB8C00"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#BDBDBD"/>
                                        <Setter Property="Foreground" Value="#757575"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 確認ボタン -->
                    <TextBlock Text="音が聞こえましたか？" FontSize="14" Foreground="#666"
                               HorizontalAlignment="Center" Margin="0,20,0,10"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="✅ はい" Command="{Binding ConfirmLeftYesCommand}"
                                Width="120" Height="45" FontSize="14" FontWeight="Bold"
                                Background="#4CAF50" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Margin="5">
                            <Button.Effect>
                                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.4"/>
                            </Button.Effect>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="8" Padding="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#66BB6A"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#E0E0E0"/>
                                            <Setter Property="Foreground" Value="#9E9E9E"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="❌ いいえ" Command="{Binding ConfirmLeftNoCommand}"
                                Width="120" Height="45" FontSize="14" FontWeight="Bold"
                                Background="#9E9E9E" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Margin="5">
                            <Button.Effect>
                                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.4"/>
                            </Button.Effect>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="8" Padding="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#BDBDBD"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#E0E0E0"/>
                                            <Setter Property="Foreground" Value="#9E9E9E"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 右スピーカーテスト -->
            <Border Grid.Column="2" Background="White" CornerRadius="15" Padding="30"
                    BorderBrush="#FF9800" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="5" BlurRadius="15" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="🔊 右スピーカー" FontSize="24" FontWeight="Bold"
                               Foreground="#FF9800" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <!-- ステータスアイコン -->
                    <Viewbox Height="120" Margin="0,20">
                        <TextBlock FontSize="80">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="⏳"/>
                                    <Setter Property="Foreground" Value="#BDBDBD"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding RightTested}" Value="True"/>
                                                <Condition Binding="{Binding RightConfirmed}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="✅"/>
                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding RightTested}" Value="True"/>
                                                <Condition Binding="{Binding RightConfirmed}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="❌"/>
                                            <Setter Property="Foreground" Value="#F44336"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Viewbox>

                    <!-- 再生ボタン -->
                    <Button Content="▶ テスト音を再生" Command="{Binding PlayRightCommand}"
                            Height="50" FontSize="16" FontWeight="Bold"
                            Background="#FF9800" Foreground="White" BorderThickness="0"
                            Cursor="Hand" Margin="0,20,0,10">
                        <Button.Effect>
                            <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.4"/>
                        </Button.Effect>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="8" Padding="15">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FB8C00"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#BDBDBD"/>
                                        <Setter Property="Foreground" Value="#757575"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 確認ボタン -->
                    <TextBlock Text="音が聞こえましたか？" FontSize="14" Foreground="#666"
                               HorizontalAlignment="Center" Margin="0,20,0,10"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="✅ はい" Command="{Binding ConfirmRightYesCommand}"
                                Width="120" Height="45" FontSize="14" FontWeight="Bold"
                                Background="#4CAF50" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Margin="5">
                            <Button.Effect>
                                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.4"/>
                            </Button.Effect>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="8" Padding="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#66BB6A"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#E0E0E0"/>
                                            <Setter Property="Foreground" Value="#9E9E9E"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="❌ いいえ" Command="{Binding ConfirmRightNoCommand}"
                                Width="120" Height="45" FontSize="14" FontWeight="Bold"
                                Background="#9E9E9E" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Margin="5">
                            <Button.Effect>
                                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.4"/>
                            </Button.Effect>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="8" Padding="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#BDBDBD"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#E0E0E0"/>
                                            <Setter Property="Foreground" Value="#9E9E9E"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ステータスメッセージ -->
        <Border Grid.Row="2" Background="White" Padding="15" Margin="20,10" CornerRadius="10"
                BorderBrush="#FF9800" BorderThickness="2">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.2"/>
            </Border.Effect>
            <TextBlock Text="{Binding StatusMessage}" FontSize="16" FontWeight="Bold"
                       Foreground="#FF9800" HorizontalAlignment="Center"/>
        </Border>

        <!-- ボタン -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="20">
            <Button Content="✅ 完了" Command="{Binding CompleteCommand}"
                    Width="150" Height="45" FontSize="16" FontWeight="Bold"
                    Background="#4CAF50" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Margin="5">
                <Button.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.4"/>
                </Button.Effect>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8" Padding="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#66BB6A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#BDBDBD"/>
                                <Setter Property="Foreground" Value="#757575"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="🔄 リセット" Command="{Binding ResetCommand}"
                    Width="150" Height="45" FontSize="16" FontWeight="Bold"
                    Background="#9E9E9E" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Margin="5">
                <Button.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.4"/>
                </Button.Effect>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8" Padding="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#BDBDBD"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
